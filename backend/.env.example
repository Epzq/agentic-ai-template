# Copy to .env and fill in. .env is gitignored — never commit it.

# Google Gemini — https://aistudio.google.com/apikey
# PAID tier required: gemini-3.1-pro-preview has no free tier.
GEMINI_API_KEY='xxx'

# Model tiering (WI-0.1 decision, verified live 2026-09-05)
#   LLM #1-#3 (extraction, candidates)  -> gemini-3.8-flash        ~2.0s
#   LLM #4    (scoring + narrative)     -> gemini-3.1-pro-preview  ~10.5s, thinking=high
ROIA_MODEL_FAST=gemini-3.8-flash
ROIA_MODEL_SMART=gemini-3.1-pro-preview

# OpenAlex — https://openalex.org/settings/api  (free, ~30s)
# REQUIRED: anonymous access is ~100 list calls per DAY, which one run exhausts.
OPENALEX_API_KEY='xxx'
OPENALEX_MAILTO=xxx@ccc.com

# The frozen demo pair (WI-0.0)
ROIA_DEMO_PROFILE_URL=

# Dev only — enables CORS for the Vite dev server on :5173
ROIA_DEV=true
