# Copy this file to `.env` and fill in the key for the provider you use.

# Anthropic (default). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- optional overrides (defaults shown) ---
# AGENT_MODEL=claude-opus-5
# AGENT_MODEL_PROVIDER=
# AGENT_TEMPERATURE=0.0
# AGENT_MAX_TOKENS=4096
# AGENT_WORKDIR=./workspace
# AGENT_REPORTS_DIR=./reports         # analyst save_report tool writes here

# Hosted alternatives - install the extra and set:
# AGENT_MODEL=openai:gpt-4.1        (uv pip install -e ".[openai]";  OPENAI_API_KEY=...)

# Web-research tools (profile_researcher, search_awarded_grants, find_competitor_labs).
# These call Gemini directly with Google Search + URL-context grounding.
#   uv pip install -e ".[gemini]"
# GOOGLE_API_KEY=
# AGENT_RESEARCHER_MODEL=gemini-2.5-flash

# --- locally hosted orchestrator (no online API call) ---
# Ollama (uv pip install -e ".[ollama]"; needs a tool-calling model):
# AGENT_MODEL=ollama:qwen2.5
# AGENT_BASE_URL=http://localhost:11434      # only if Ollama runs on another host
#
# OpenAI-compatible local server - llama.cpp, vLLM, LM Studio (uv pip install -e ".[openai]"):
# AGENT_MODEL=openai:qwen2.5-7b-instruct
# AGENT_BASE_URL=http://localhost:8080/v1
# AGENT_API_KEY=local                        # placeholder; local servers ignore it
